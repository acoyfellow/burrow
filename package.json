{
  "name": "coil",
  "version": "0.0.1",
  "description": "One thread, one agent, one computer. Pi Durable and a Cloudflare container per thread, compacted together.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoyfellow/coil.git"
  },
  "scripts": {
    "dev": "node scripts/build-term.mjs && wrangler dev",
    "deploy": "node scripts/build-term.mjs && wrangler deploy",
    "typecheck": "node scripts/build-term.mjs && tsc -p . && tsc -p tsconfig.client.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "check": "node scripts/build-term.mjs && bash scripts/check.sh",
    "build:term": "node scripts/build-term.mjs",
    "ship": "bash scripts/ship.sh"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@effect/platform-browser": "4.0.0",
    "cloudterm": "github:acoyfellow/cloudterm#2fbaeb4",
    "effect": "4.0.0",
    "foldkit": "0.166.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@cloudflare/workers-types": "^5.20261010.1",
    "@foldkit/vite-plugin": "0.26.1",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "lucide-static": "^1.55.0",
    "typescript": "^5.9.3",
    "vite": "8.3.3",
    "vitest": "^5.0.3",
    "wrangler": "4.149.0"
  }
}
