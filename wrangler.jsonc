{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "coil",
  "main": "src/index.ts",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "ai": { "binding": "AI", "remote": true },
  "vars": { "MODEL": "@cf/zai-org/glm-5.3", "AI_GATEWAY": "default" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/t/*", "/api/*", "/mcp", "/assets/*", "/sw.js"] },
  "containers": [
    {
      "class_name": "Thread",
      "scheduling_policy": "durable_object",
      "images": { "computer": { "dockerfile": "./computer/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "THREAD", "class_name": "Thread" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Thread"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ]
}
